{
  "manifest_version": 3,
  "name": "PhishCheck",
  "version": "0.1.0",
  "description": "Local, explainable phishing indicator analysis for Gmail.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://mail.google.com/*", "https://gmail.com/*", "https://www.gmail.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Analyze this Gmail message",
    "default_popup": "src/popup/index.html"
  },
  "content_scripts": [
    { "matches": ["https://mail.google.com/*", "https://gmail.com/*", "https://www.gmail.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}